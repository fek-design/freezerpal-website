---
import Layout from '../layouts/Layout.astro';
import { SidebarBG } from '../components/SidebarBG.tsx'; 
import { HeaderBG } from '../components/HeaderBG.tsx'; 
import { BrandLogo } from '../components/Brand/BrandLogo';
import { BrandColors } from '../components/Brand/BrandColors';
import { BrandFonte } from '../components/Brand/BrandFonte';
import { BrandIkoner } from '../components/Brand/BrandIkoner';
import { BrandBackgrounds } from '../components/Brand/BrandBackgrounds';
import { BrandBilledestil } from '../components/Brand/BrandBilledestil';
import { BrandButtons } from '../components/Brand/BrandButtons';
---

<Layout title="FreezerPal Brand Guide">
  <div class="bg-brand-dark w-full border-b border-brand-dark/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <HeaderBG client:load />
    </div>
  </div>
  
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 bg-white/5 pt-12 pb-24">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16">
      
      <SidebarBG client:load activeSection="logo" />
      
      <div class="lg:col-span-9">
        <BrandLogo client:load />
        <BrandColors client:load />
        <BrandFonte client:load />
        <BrandIkoner client:load />
        <BrandBackgrounds client:load />
        <BrandBilledestil client:load />
        <BrandButtons client:load />
      </div>
    </div>
  </div>

  <script>
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const activeLinkId = entry.target.id;
          const links = document.querySelectorAll('nav.flex a');
          
          links.forEach(link => {
            if (link.getAttribute('href') === `#${activeLinkId}`) {
              link.classList.add('text-brand-light', 'font-bold');
              link.classList.remove('text-brand-dark');
            } else {
              link.classList.remove('text-brand-light', 'font-bold');
              link.classList.add('text-brand-dark');
            }
          });
        }
      });
    }, { rootMargin: '-20% 0px -60% 0px' });

    ['logo', 'farver', 'fonte', 'ikoner', 'baggrund', 'billede-stil', 'knapper'].forEach(id => {
      const el = document.getElementById(id);
      if (el) observer.observe(el);
    });
  </script>
</Layout>